# Copy to .env (gitignored) or export in your runner's environment.

# --- Required ---
# Your Notion integration token and the database that receives picks.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- Travel times (optional feature) ---
# Google Maps Routes API key (a GCP project with Routes API enabled).
GOOGLE_MAPS_API_KEY=
# Where your journeys start, and how reports should label it.
ER_HOME_POSTCODE=SW1A 1AA
ER_HOME_LABEL=Central London (SW1A 1AA)

# --- City (defaults describe London; point them at any city) ---
# Everything below drives where the pipeline looks and how it geocodes:
# set these and the same pipeline works anywhere. Examples in comments.
ER_CITY_NAME=London
ER_TIMEZONE=Europe/London
ER_CITY_LAT=51.5074
ER_CITY_LON=-0.1278
# Appended to every geocoding query so venues/postcodes resolve in YOUR
# city, not a same-named place elsewhere. e.g. "Berlin, Germany",
# "Brooklyn, NY, USA".
ER_GEOCODE_SUFFIX=London, UK
# Optional ISO-3166 region bias for geocoding accuracy (gb, de, us, ...).
ER_GEOCODE_REGION=gb
# Luma discovery area for your city: the discplace-* id from
# api.lu.ma/discover (open the city page, read it from the network request
# or the page URL). Default is London. Leave as-is if you don't use Luma.
ER_LUMA_PLACE_ID=discplace-QCcNk3HXowOR97j

# --- Meetup (optional) ---
# Your Meetup group memberships, comma-separated URL slugs (the part after
# meetup.com/). Fetched as a priority source ahead of the discovery feed.
ER_MEETUP_GROUPS=ai-builders-club,creative-tech-collective,city-bouldering-social,synth-makers-meetup

# --- Optional integrations ---
# ntfy.sh topic for run notifications on your phone.
NTFY_TOPIC=
# Google Calendar sync (OAuth refresh-token flow).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Google Calendar id that sync_to_gcal.py writes events to (create a
# dedicated calendar and copy its id from the calendar's settings).
#GCAL_CALENDAR_ID=
# Scoring Feedback Notion database (feedback_digest.py writes digests and
# findings here; apply_findings.py reads approved findings back). See the
# "Scoring Feedback database" section of docs/setup-guide.md.
#FEEDBACK_DB_ID=
# Pipeline Runs Notion database (printed by scripts/bootstrap_notion.py;
# used by the weekly run log and the feedback digest's health section).
#PIPELINE_RUNS_DB_ID=
# Note: GMAIL_TOKEN_JSON (the Gmail OAuth token used by label-emails.yml)
# is never kept in .env; it lives only as a GitHub Actions secret.
# Repo slug used by workflow dispatch helpers.
ER_REPO_SLUG=haniabdemai/event-recommender
# Personal-calendar filtering (feedback_digest.py): extra comma-separated
# regular expressions for calendar entries that are personal business, not
# attendable public events (hobbies, clinics, regular commitments).
#ER_PERSONAL_EVENT_PATTERNS=
#ER_PERSONAL_LOCATION_PATTERNS=
